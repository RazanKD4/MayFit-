<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".premiumActivity">

    <TextView
        android:id="@+id/gold_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="MayFit+ GOLD"
        android:textAlignment="center"
        android:textColor="#FFD700"
        android:textSize="70dp"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="30dp"
        android:background="#00ddc0"/>

    <GridLayout
        android:id="@+id/personal_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:columnCount="2"
        android:paddingStart="10dp"
        android:rowCount="3"
        android:paddingTop="4mm"
        app:layout_constraintTop_toBottomOf="@id/gold_text">

        <TextView
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:fontFamily="@font/poppinslight"
            android:text="Get personalized\nexercise routine..."
            android:textAlignment="center"
            android:textSize="25dp"
            tools:layout_editor_absoluteX="16dp"
            android:id="@+id/personal_text"/>

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginLeft="8mm"
            app:srcCompat="@drawable/img_forscw"/>
    </GridLayout>


    <GridLayout
        android:id="@+id/grid_recipe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:columnCount="3"
        android:paddingStart="10dp"
        android:rowCount="3"
        android:paddingTop="4mm"
        app:layout_constraintTop_toBottomOf="@id/personal_grid">


        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:srcCompat="@drawable/detail_img_lunch2"
            android:id="@+id/imageView2" />


        <ImageView
            android:id="@+id/recipe1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:rotation="20"
            app:srcCompat="@drawable/detail_img_dinner1" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppinslight"
            android:text="hand-picked recipe\nfor your needs..."
            android:textAlignment="center"
            android:textSize="25dp"
            android:layout_marginLeft="5mm"
            tools:layout_editor_absoluteX="149dp"
            android:id="@+id/recipe_text"
            tools:layout_editor_absoluteY="360dp" />
    </GridLayout>


    <GridLayout
        android:id="@+id/ad_grid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:columnCount="2"
        android:paddingStart="10dp"
        android:rowCount="3"
        android:paddingTop="4mm"
        app:layout_constraintTop_toBottomOf="@id/grid_recipe">

    <TextView
        android:id="@+id/ad_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppinslight"
        android:text="and no ads."
        android:textAlignment="center"
        android:textSize="25dp" />


    <ImageView
        android:layout_height="100dp"
        android:layout_width="100dp"
        app:srcCompat="@drawable/ad_free"
        tools:layout_editor_absoluteX="279dp"
        android:id="@+id/imageView4"
        android:layout_marginLeft="21mm"/>

    </GridLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/premium_back_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        app:backgroundTint="@color/white"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="340sp"
        android:layout_marginTop="40sp" />

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_horizontal"
        android:text="Purchase Now!\nRp50.000/month"
        android:textSize="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>